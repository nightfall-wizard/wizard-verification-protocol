{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wvp.local/schemas/auneya-pulse-flow-v0.1.schema.json",
  "title": "AUNEYA Pulse and Prooflet Flow Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "flow_id",
    "flow_type",
    "claim_ref",
    "witness",
    "cadence",
    "pulses",
    "micro_proofs",
    "prooflet",
    "lawful_boundary_confirmation",
    "simulated_reward_entry",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "auneya-pulse-flow-v0.1"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^auneya_flow_[a-z0-9_\\-]{8,120}$"
    },
    "flow_type": {
      "type": "string",
      "enum": [
        "phone_witness_loop",
        "ci_simulation_loop"
      ]
    },
    "claim_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_schema_version",
        "claim_hash"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^auneya_claim_[a-z0-9_\\-]{8,80}$"
        },
        "claim_schema_version": {
          "type": "string",
          "const": "auneya-claim-v0.1"
        },
        "claim_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "device_class",
        "environment_class",
        "software_name",
        "software_version"
      ],
      "properties": {
        "witness_id": {
          "type": "string",
          "pattern": "^witness_[a-z0-9_\\-]{8,100}$"
        },
        "device_class": {
          "type": "string",
          "enum": [
            "android_termux",
            "linux_ci",
            "linux_desktop",
            "unknown"
          ]
        },
        "environment_class": {
          "type": "string",
          "enum": [
            "phone_safe",
            "ci_runner",
            "desktop",
            "unknown"
          ]
        },
        "software_name": {
          "type": "string",
          "enum": [
            "wvp",
            "auneya-witness"
          ]
        },
        "software_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pulse_interval_seconds",
        "micro_proof_every_pulses",
        "prooflet_every_micro_proofs",
        "max_duration_seconds"
      ],
      "properties": {
        "pulse_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "micro_proof_every_pulses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "prooflet_every_micro_proofs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "pulses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pulse_index",
          "pulse_type",
          "target_locator",
          "observed_status",
          "observed_at"
        ],
        "properties": {
          "pulse_index": {
            "type": "integer",
            "minimum": 1
          },
          "pulse_type": {
            "type": "string",
            "enum": [
              "http_status",
              "content_hash",
              "release_metadata",
              "page_snapshot_hash",
              "dns_record",
              "tls_certificate",
              "file_metadata"
            ]
          },
          "target_locator": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1000
          },
          "observed_status": {
            "type": "string",
            "enum": [
              "observed",
              "unverifiable",
              "stale",
              "dangerous"
            ]
          },
          "evidence_hint": {
            "type": "string",
            "maxLength": 300
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "micro_proofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "micro_proof_id",
          "pulse_indexes",
          "micro_proof_hash",
          "observed_status",
          "created_at"
        ],
        "properties": {
          "micro_proof_id": {
            "type": "string",
            "pattern": "^auneya_micro_proof_[a-z0-9_\\-]{8,120}$"
          },
          "pulse_indexes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "micro_proof_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "observed_status": {
            "type": "string",
            "enum": [
              "observed",
              "unverifiable",
              "stale",
              "dangerous"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "prooflet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prooflet_id",
        "claim_id",
        "micro_proof_ids",
        "observed_status",
        "prooflet_hash",
        "created_at"
      ],
      "properties": {
        "prooflet_id": {
          "type": "string",
          "pattern": "^auneya_prooflet_[a-z0-9_\\-]{8,120}$"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^auneya_claim_[a-z0-9_\\-]{8,80}$"
        },
        "micro_proof_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^auneya_micro_proof_[a-z0-9_\\-]{8,120}$"
          }
        },
        "observed_status": {
          "type": "string",
          "enum": [
            "observed",
            "unverifiable",
            "stale",
            "dangerous"
          ]
        },
        "prooflet_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lawful_boundary_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_or_authorized_target",
        "no_private_data_accessed",
        "no_hacked_data_used",
        "no_paywall_bypass_used",
        "no_credentials_used",
        "no_surveillance_performed",
        "notes"
      ],
      "properties": {
        "public_or_authorized_target": {
          "type": "boolean",
          "const": true
        },
        "no_private_data_accessed": {
          "type": "boolean",
          "const": true
        },
        "no_hacked_data_used": {
          "type": "boolean",
          "const": true
        },
        "no_paywall_bypass_used": {
          "type": "boolean",
          "const": true
        },
        "no_credentials_used": {
          "type": "boolean",
          "const": true
        },
        "no_surveillance_performed": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        }
      }
    },
    "simulated_reward_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_type",
        "unit",
        "amount",
        "transferable",
        "market_value_claimed",
        "notes"
      ],
      "properties": {
        "entry_type": {
          "type": "string",
          "const": "non_value_simulation"
        },
        "unit": {
          "type": "string",
          "const": "simulated_neya"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "transferable": {
          "type": "boolean",
          "const": false
        },
        "market_value_claimed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "non_value_notice": {
      "type": "string",
      "maxLength": 500
    }
  }
}
