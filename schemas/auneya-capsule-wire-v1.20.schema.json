{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nightfall-wizard/wizard-verification-protocol/blob/main/schemas/auneya-capsule-wire-v1.20.schema.json",
  "title": "AUNEYA research capsule wire candidate v1.20",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "chain_id",
    "sequence",
    "anchor_sha256",
    "quorum_report_sha256",
    "current",
    "previous"
  ],
  "properties": {
    "format": {
      "const": "auneya-portable-quorum-capsule-v1.12"
    },
    "chain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "anchor_sha256": {
      "$ref": "#/$defs/hash"
    },
    "quorum_report_sha256": {
      "$ref": "#/$defs/hash"
    },
    "current": {
      "$ref": "#/$defs/bundle"
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bundle"
        }
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "anchor_b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "minLength": 4,
      "maxLength": 1398104
    },
    "receipt_b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "minLength": 4,
      "maxLength": 21848
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin",
        "payload_b64"
      ],
      "properties": {
        "pin": {
          "$ref": "#/$defs/hash"
        },
        "payload_b64": {
          "$ref": "#/$defs/receipt_b64"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_b64",
        "receipts"
      ],
      "properties": {
        "anchor_b64": {
          "$ref": "#/$defs/anchor_b64"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    }
  }
}
