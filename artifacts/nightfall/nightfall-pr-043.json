  "title": "Do not mine while a fresh peer is known to be ahead",
  "user": {
    "login": "parthod0x",
    "id": 260393540,
    "node_id": "U_kgDOD4VKRA",
    "avatar_url": "https://avatars.githubusercontent.com/u/260393540?v=4",
